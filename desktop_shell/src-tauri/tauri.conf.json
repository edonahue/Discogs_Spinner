{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Discogs Spinner",
  "version": "0.2.2",
  "identifier": "com.discogs-spinner.app",
  "build": {
    "beforeDevCommand": "cd ../webapp && npm run dev",
    "beforeBuildCommand": "cd ../webapp && npm run build",
    "frontendDist": "../../webapp/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "title": "Discogs Spinner",
        "width": 1280,
        "height": 820,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "msi", "nsis", "dmg", "msix"],
    "icon": [
      "../icons/32x32.png",
      "../icons/128x128.png",
      "../icons/128x128@2x.png",
      "../icons/icon.icns",
      "../icons/icon.ico"
    ],
    "externalBin": ["binaries/dplayer-api"],
    "category": "Music",
    "shortDescription": "Browse, spin, and value your Discogs vinyl collection.",
    "longDescription": "Discogs Spinner is a local-first desktop companion for vinyl collectors. Connect a Discogs personal access token, sync your collection and wantlist, spin a random record, inspect market value, and optionally hand playback to Spotify or YouTube Music.",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "msix": {
        "identityName": "EricDonahue.SpinnerforDiscogs",
        "publisherDisplayName": "Eric Donahue"
      }
    },
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
