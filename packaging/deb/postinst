#!/bin/bash
# postinst — run after dpkg installs the discogs-spinner .deb.
#
# Creates a virtualenv at /opt/discogs-spinner/venv and installs the bundled
# discogs_player wheelhouse into it (GTK4 GUI + local API profile).
set -euo pipefail

INSTALL_PREFIX="/opt/discogs-spinner"
VENV_PATH="${INSTALL_PREFIX}/venv"
WHEEL_DIR="${INSTALL_PREFIX}/wheels"

case "$1" in
    configure)
        echo "Setting up Spinner for Discogs virtualenv..."

        # Create venv if it doesn't exist yet.
        if [[ ! -d "$VENV_PATH" ]]; then
            python3 -m venv --system-site-packages "$VENV_PATH"
        fi

        shopt -s nullglob
        app_wheels=("${WHEEL_DIR}"/discogs_player-*.whl)
        shopt -u nullglob

        if [[ ${#app_wheels[@]} -eq 0 ]]; then
            echo "ERROR: No bundled discogs_player wheel found in ${WHEEL_DIR}." >&2
            exit 1
        fi

        app_version="$(basename "${app_wheels[0]}")"
        app_version="${app_version#discogs_player-}"
        app_version="${app_version%%-*}"

        PIP_DISABLE_PIP_VERSION_CHECK=1 \
            "${VENV_PATH}/bin/pip" install --quiet --upgrade \
            --no-index \
            --find-links "$WHEEL_DIR" \
            "discogs_player[web]==${app_version}"

        # Update desktop database so the launcher is indexed.
        if command -v update-desktop-database >/dev/null 2>&1; then
            update-desktop-database /usr/share/applications || true
        fi

        echo ""
        echo "Spinner for Discogs installed."
        echo ""
        echo "First-time setup for vinyl collectors:"
        echo "  1. Get your Discogs personal access token:"
        echo "     https://www.discogs.com/settings/developers"
        echo "  2. Launch Spinner for Discogs from your app menu and paste the token"
        echo "     into the setup wizard."
        echo "  3. Sync once, then browse your records and use Spin when you"
        echo "     want a quick pick from your shelf."
        echo ""
        echo "Terminal alternative:"
        echo "  Store the token:"
        echo "       dplayer config set discogs_token <your_token>"
        echo "     or export DISCOGS_TOKEN=\"your_token\" in your shell profile."
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        ;;

    *)
        echo "postinst called with unknown argument: '$1'" >&2
        exit 1
        ;;
esac

exit 0
