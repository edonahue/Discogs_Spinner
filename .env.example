# Preferred: export tokens in your shell profile for SSH sessions.
# Discogs token (required for sync)
DISCOGS_TOKEN=your_discogs_personal_access_token

# Spotify playback options:
# 1) simplest: provide short-lived access token directly
SPOTIFY_ACCESS_TOKEN=your_spotify_access_token

# 2) optional auto-refresh credentials (recommended for long-running CLI use)
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_SECRET=your_spotify_client_secret
# Legacy alias also accepted:
# SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REFRESH_TOKEN=your_spotify_refresh_token
